{
  "name": "biodash_ai-service",
  "version": "0.4.1",
  "description": "Microserviço de PLN e Chatbot do BioDash (FastAPI + Whisper)",
  "scripts": {
    "dev": "uv run --python 3.11 --with-requirements requirements.txt uvicorn main:app --host 127.0.0.1 --port 5000",
    "test": "python -m pytest -q",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose up -d --build",
    "docker:logs": "docker logs -f biodash_ai-service",
    "docker:ps": "docker compose ps",
    "lint": "ruff check ."
  },
  "keywords": [
    "biodash",
    "fastapi",
    "whisper",
    "ai",
    "nlp"
  ],
  "author": "",
  "license": "ISC"
}
